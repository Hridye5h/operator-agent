# Optional. Without this the agent uses its deterministic planner and says so.
# Copy this file to .env (which is gitignored) and add a key from aistudio.google.com/apikey.
GEMINI_API_KEY=

# Set to 0 to disable the transient-failure injection in the mock system.
FAIL_FIRST_SUBMIT=1

# Optional. Pin a model. If unset, the planner uses the first of gemini-2.5-flash,
# gemini-flash-latest, gemini-2.0-flash this key can call, then other Flash models,
# and moves to the next one when a daily quota runs out or a model is overloaded.
# GEMINI_MODEL=gemini-2.5-flash
