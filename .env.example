# Optional. Without this the agent uses its deterministic planner and says so.
# Copy this file to .env (which is gitignored) and add a key from aistudio.google.com/apikey.
GEMINI_API_KEY=

# Set to 0 to disable the transient-failure injection in the mock system.
FAIL_FIRST_SUBMIT=1

# Optional. Pin a model; if unset, the first available of gemini-2.5-flash,
# gemini-flash-latest, gemini-2.0-flash is used.
# GEMINI_MODEL=gemini-2.5-flash
